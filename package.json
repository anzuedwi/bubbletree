{
  "name": "bubbletree",
  "version": "3.0.0",
  "description": "BubbleTree is a library for interactive visualization of hierarchical data.",
  "type": "module",
  "main": "dist/bubbletree.js",
  "module": "dist/bubbletree.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/bubbletree.js",
      "types": "./dist/index.d.ts"
    },
    "./components": {
      "import": "./dist/components.js",
      "types": "./dist/components/index.d.ts"
    },
    "./style.css": "./dist/bubbletree.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okfn/bubbletree.git"
  },
  "author": {
    "name": "Gregor Aisch",
    "url": "http://vis4.net/blog/"
  },
  "contributors": [
    {
      "name": "Rufus Pollock",
      "url": "http://rufuspollock.org/"
    },
    {
      "name": "Levko Kravets",
      "email": "levko.ne@gmail.com"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/okfn/bubbletree/issues"
  },
  "homepage": "http://okfnlabs.org/bubbletree",
  "dependencies": {
    "d3-color": "^3.1.0",
    "d3-ease": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "lit": "^3.1.4"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.1.0",
    "@storybook/addon-interactions": "^8.1.0",
    "@storybook/test": "^8.1.0",
    "@storybook/web-components": "^8.1.0",
    "@storybook/web-components-vite": "^8.1.0",
    "@types/d3-color": "^3.1.3",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-selection": "^3.0.10",
    "@types/d3-transition": "^3.0.8",
    "@vitest/coverage-v8": "^1.6.0",
    "happy-dom": "^14.7.0",
    "storybook": "^8.1.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
