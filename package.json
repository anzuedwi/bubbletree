{
  "name": "bubbletree",
  "version": "3.0.0",
  "description": "BubbleTree is a library for interactive visualization of hierarchical data.",
  "type": "module",
  "main": "dist/bubbletree.js",
  "module": "dist/bubbletree.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/bubbletree.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/bubbletree.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okfn/bubbletree.git"
  },
  "author": {
    "name": "Gregor Aisch",
    "url": "http://vis4.net/blog/"
  },
  "contributors": [
    {
      "name": "Rufus Pollock",
      "url": "http://rufuspollock.org/"
    },
    {
      "name": "Levko Kravets",
      "email": "levko.ne@gmail.com"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/okfn/bubbletree/issues"
  },
  "homepage": "http://okfnlabs.org/bubbletree",
  "dependencies": {
    "d3-color": "^3.1.0",
    "d3-ease": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1"
  },
  "devDependencies": {
    "@types/d3-color": "^3.1.3",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-selection": "^3.0.10",
    "@types/d3-transition": "^3.0.8",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  }
}
